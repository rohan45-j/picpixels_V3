NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: Internal backend URL for high-speed server-to-server loopback SSR (e.g. http://127.0.0.1:8000 on VPS)
INTERNAL_API_URL=http://127.0.0.1:8000

# Cloudflare Turnstile Bot Protection
# For local testing, use Cloudflare's official test site key: 1x00000000000000000000AA (always passes)
# In production, set your Cloudflare Turnstile public Site Key:
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
