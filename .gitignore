# ==========================================
# PicPixels Production .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Next.js / Node.js
**/node_modules/
node_modules/
**/.next/
.next/
**/out/
out/
**/build/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
.eslintcache

# Python / Django
**/__pycache__/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
**/venv/
venv/
**/env/
env/
**/.venv/
.venv/
ENV/
env.bak/
venv.bak/

# Django Database & Storage
*.sqlite3
db.sqlite3
**/media/
!**/media/**/.gitkeep
**/staticfiles/

# Logs & Runtime
*.log
logs/
*.pid
*.seed

# OS & IDE
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Archives & Temporary files
*.zip
*.tar.gz
*.rar
*.bak
*.tmp
