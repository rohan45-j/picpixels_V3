DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,admin.picpixels.com
FRONTEND_URL=http://localhost:3000

# Cloudflare Turnstile Bot Protection
# For local testing, use Cloudflare's official test keys:
# Secret: 1x0000000000000000000000000000000AA (always passes)
# In production, replace with your Cloudflare Turnstile Secret Key:
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
BOT_PROTECTION_ENABLED=True

# Optional Database & Redis
# DB_HOST=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# REDIS_URL=redis://localhost:6379/0
